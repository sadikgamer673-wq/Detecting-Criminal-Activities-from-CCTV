# Server configuration
APP_NAME="Detecting Criminal Activities from CCTV Using Object Detection and Machine Learning Algorithms"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database
DATABASE_URL="sqlite+aiosqlite:///./cctv_surveillance.db"

# Storage paths
STORAGE_ROOT="../storage"
UPLOAD_DIR="../storage/uploads"
INCIDENT_DIR="../storage/incidents"
MODEL_DIR="../storage/models"

# Detection settings
SAMPLING_RATE_FPS=5
CONFIDENCE_THRESHOLD=0.25
EVENT_COOLDOWN_SECONDS=10
MAX_UPLOAD_SIZE_MB=500
